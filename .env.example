# Server
PORT=3001
HOST=0.0.0.0

# JWT Secret (required — generate with: openssl rand -base64 32)
JWT_SECRET=change-this-to-a-random-secret

# Database (optional — falls back to in-memory if not set)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=resume_builder
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# Azure OpenAI / Foundry (optional — without this, LLM stages return empty mock responses)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Blob Storage (optional — falls back to no external storage)
BLOB_ACCOUNT_NAME=your_account_name
BLOB_ACCOUNT_KEY=your_account_key
BLOB_CONTAINER=resumes

# Azure Document Intelligence (optional — falls back to no document parsing)
DOC_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
DOC_INTELLIGENCE_KEY=your_api_key

# Azure AI Search (optional — falls back to DB/in-memory fact search)
SEARCH_ENDPOINT=https://your-search.search.windows.net
SEARCH_KEY=your_search_key
SEARCH_INDEX=candidate-facts
