# Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# Web client API base (omit for local web + local API, or point to Azure)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Optional server-side rewrite target; defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:3001/api/v1

# Azure Key Vault (authenticate locally with: az login)
KEY_VAULT_URL=https://your-key-vault.vault.azure.net/

# Non-secret database settings
DATABASE_HOST=your-server.postgres.database.azure.com
DATABASE_PORT=5432
DATABASE_NAME=resume_builder
DATABASE_SSL=true

# Non-secret Azure service settings
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

BLOB_ACCOUNT_NAME=your_account_name
BLOB_CONTAINER=resumes

DOC_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com

SEARCH_ENDPOINT=https://your-search.search.windows.net
SEARCH_INDEX=candidate-facts
