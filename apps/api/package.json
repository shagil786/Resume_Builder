{
  "name": "@resume-builder/api",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "build:function": "esbuild src/function.ts --bundle --platform=node --format=esm --target=node22 --external:@azure/functions --external:@azure/identity --external:@azure/keyvault-secrets --external:@azure/storage-blob --external:@fastify/cookie --external:@fastify/cors --external:@fastify/jwt --external:@fastify/rate-limit --external:@fastify/multipart --external:fastify --external:fastify-plugin --external:drizzle-orm --external:postgres --external:playwright --external:playwright-core --external:chromium-bidi --external:fsevents --outfile=dist/function.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/functions": "^4.16.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@resume-builder/ai": "*",
    "@resume-builder/config": "*",
    "@resume-builder/db": "*",
    "@resume-builder/document-intelligence": "*",
    "@resume-builder/domain": "*",
    "@resume-builder/rendering": "*",
    "@resume-builder/search": "*",
    "@resume-builder/shared": "*",
    "@resume-builder/storage": "*",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.19.3",
    "vitest": "^4.1.10"
  }
}
